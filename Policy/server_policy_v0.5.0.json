{
  "policy_id": "app:slack-proxy",
  "version": "0.5.0",
  "scope": "global",
  "resources": [
    "tool:slack-proxy/slack_send_message",
    "tool:slack-proxy/slack_send_message_draft",
    "tool:slack-proxy/slack_search_public",
    "tool:slack-proxy/slack_search_channels",
    "tool:slack-proxy/slack_read_channel",
    "tool:slack-proxy/slack_read_thread",
    "tool:slack-proxy/slack_read_user_profile",
    "tool:slack-proxy/slack_list_channel_members"
  ],
  "denied_resources": [
    "tool:slack-proxy/slack_schedule_message",
    "tool:slack-proxy/slack_search_public_and_private"
  ],
  "attestations": [
    "send_message_approval::{params.message != '' AND params.tasks_claude == 'no'}",
    "claude_agent_approval::{params.tasks_claude == 'yes' AND params.github_intent == 'write'}"
  ],
  "constraints": {
    "attestations": {
      "send_message_approval": {
        "approval_criteria": "user:adibhatt2203@gmail.com",
        "description": "Outbound Slack message that does NOT task the Claude agent -- requires the user's just-in-time approval before it is sent.",
        "timeout": 300,
        "time_to_live": 300,
        "one_time": true
      },
      "claude_agent_approval": {
        "approval_criteria": "user:adibhatt2203@gmail.com",
        "description": "A WRITE task to the in-workspace Claude agent on a permitted public repo -- Claude acts on GitHub outside MACAW, so a write requires explicit just-in-time sign-off. (Destructive intent and private/denied-org repos are hard-denied earlier; reads pass.)",
        "timeout": 300,
        "time_to_live": 300,
        "one_time": true
      }
    },
    "parameters": {
      "tool:slack-proxy/slack_send_message": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message": {"type": "string", "min_length": 1, "max_length": 4000},
        "thread_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "github_intent": {"type": "string", "allowed_values": ["none", "read", "write"]},
        "repo_scope": {"type": "string", "allowed_values": ["public", "none"]}
      },
      "tool:slack-proxy/slack_send_message_draft": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message": {"type": "string", "min_length": 1, "max_length": 4000},
        "thread_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "github_intent": {"type": "string", "allowed_values": ["none", "read", "write"]},
        "repo_scope": {"type": "string", "allowed_values": ["public", "none"]}
      },
      "tool:slack-proxy/slack_search_public": {
        "query": {"type": "string", "min_length": 1, "max_length": 500},
        "limit": {"type": "integer", "min": 1, "max": 20},
        "sort": {"type": "string", "allowed_values": ["score", "timestamp"]},
        "sort_dir": {"type": "string", "allowed_values": ["asc", "desc"]},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_search_channels": {
        "query": {"type": "string", "min_length": 1, "max_length": 200},
        "limit": {"type": "integer", "min": 1, "max": 20},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_channel": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 100},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_thread": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 1000},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_user_profile": {
        "user_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_list_channel_members": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 30},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise", "ids_only"]}
      }
    },
    "denied_parameters": {
      "tool:slack-proxy/slack_send_message": {
        "message": ["*-----BEGIN*PRIVATE KEY*", "*xoxb-*", "*xoxp-*", "*xoxc-*", "*xoxd-*", "*macawsecurity*", "*MacawSecurity*", "*MACAWSECURITY*"]
      },
      "tool:slack-proxy/slack_send_message_draft": {
        "message": ["*-----BEGIN*PRIVATE KEY*", "*xoxb-*", "*xoxp-*", "*xoxc-*", "*xoxd-*", "*macawsecurity*", "*MacawSecurity*", "*MACAWSECURITY*"]
      }
    }
  },
  "description": "Slack MCP via SecureMCPProxy, with the SlackTaskVerifier stamping tasks_claude / github_intent / repo_scope on outbound sends. Reads and public search are open. A normal send needs the user's approval (send_message_approval). A task to the in-workspace Claude agent is routed by intent: destructive intent and private/denied-org repos are hard-denied before approval; a write on a permitted public repo needs approval (claude_agent_approval); a read passes. Scheduled send and private/DM search denied; message secret- and org-screened and size-capped."
}
