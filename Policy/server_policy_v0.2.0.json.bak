{
  "policy_id": "app:slack-proxy",
  "version": "0.2.0",
  "scope": "global",
  "resources": [
    "tool:slack-proxy/slack_send_message",
    "tool:slack-proxy/slack_send_message_draft",
    "tool:slack-proxy/slack_search_public",
    "tool:slack-proxy/slack_search_channels",
    "tool:slack-proxy/slack_read_channel",
    "tool:slack-proxy/slack_read_thread",
    "tool:slack-proxy/slack_read_user_profile",
    "tool:slack-proxy/slack_list_channel_members"
  ],
  "denied_resources": [
    "tool:slack-proxy/slack_schedule_message",
    "tool:slack-proxy/slack_search_public_and_private"
  ],
  "attestations": [
    "send_message_approval::{params.message != ''}"
  ],
  "constraints": {
    "attestations": {
      "send_message_approval": {
        "approval_criteria": "user:adibhatt2203@gmail.com",
        "description": "Outbound Slack message -- requires the user's just-in-time approval before it is sent",
        "timeout": 300,
        "time_to_live": 300,
        "one_time": true
      }
    },
    "parameters": {
      "tool:slack-proxy/slack_send_message": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message": {"type": "string", "min_length": 1, "max_length": 4000},
        "thread_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      },
      "tool:slack-proxy/slack_send_message_draft": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message": {"type": "string", "min_length": 1, "max_length": 4000},
        "thread_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      },
      "tool:slack-proxy/slack_search_public": {
        "query": {"type": "string", "min_length": 1, "max_length": 500},
        "limit": {"type": "integer", "min": 1, "max": 20},
        "sort": {"type": "string", "allowed_values": ["score", "timestamp"]},
        "sort_dir": {"type": "string", "allowed_values": ["asc", "desc"]},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_search_channels": {
        "query": {"type": "string", "min_length": 1, "max_length": 200},
        "limit": {"type": "integer", "min": 1, "max": 20},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_channel": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 100},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_thread": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "message_ts": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 1000},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_read_user_profile": {
        "user_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise"]}
      },
      "tool:slack-proxy/slack_list_channel_members": {
        "channel_id": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9]+$"},
        "limit": {"type": "integer", "min": 1, "max": 30},
        "response_format": {"type": "string", "allowed_values": ["detailed", "concise", "ids_only"]}
      }
    },
    "denied_parameters": {
      "tool:slack-proxy/slack_send_message": {
        "message": ["*-----BEGIN*PRIVATE KEY*", "*xoxb-*", "*xoxp-*", "*xoxc-*", "*xoxd-*"]
      },
      "tool:slack-proxy/slack_send_message_draft": {
        "message": ["*-----BEGIN*PRIVATE KEY*", "*xoxb-*", "*xoxp-*", "*xoxc-*", "*xoxd-*"]
      }
    }
  },
  "description": "Slack MCP via SecureMCPProxy -- reads + public search open; outbound send requires just-in-time user approval; scheduled send and private/DM search denied; message secret-screened and size-capped."
}
